# Copy to .env.local. Never commit API keys.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# Set a model available to your account; "bike-agent llm check" lists models.
DEEPSEEK_MODEL=
# Optional online map configuration; offline spatial results remain available.
AMAP_KEY=
AMAP_SECURITY_CODE=
